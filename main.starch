// Variables
var x: int = 1;
const PI: float = 3.14;
var name: str = "Alice";
var flag: bool = true;

// Lists and dicts
var nums = [1, 2, 3];
var person = {"name": "Alice", "age": 30};

// Arithmetic
var a = 2 ^ 8;
var b = 10 % 3;
var c = -5;
var d = "hello" ~ " world";

// Comparison
var e = 1 == 1;
var f = 1 != 2;
var g = 1 < 2;
var h = 2 >= 1;
var i = 50 ≈ 54;

// Logical
var j = true and false;
var k = true or false;
var l = not true;
var m = true and not false;

// In / not in
var n = 1 in nums;
var o = 5 not in nums;

// Is / is not
var p = x is int;
var q = x is not str;

// Assignment
x = 10;
x += 5;
x -= 2;
x *= 3;
x /= 2;

// Pipelines
"hello" ~> print();
"hello" ~> .upper() ~> print();
person ~> .name;

// If / elif / else
if x > 5 {
	print("big");
} elif x == 5 {
	print("five");
} else {
	print("small");
}

// While
var counter: int = 0;
while counter < 10 {
	counter += 1;
}

// For
for i in [1..10] {
	print(i);
}

// For with step
for i in [0..100..2] {
	print(i);
}

// For over list
for item in nums {
	print(item);
}

// Match
match x {
	case 1, 2, 3 {
		print("small");
	}
	case 10 {
		print("ten");
	}
	case _ {
		print("other");
	}
}

// Functions
function add(a: int, b: int) -> int {
	return a + b;
}

function greet(name: str or "World") -> void {
	print("Hello, " ~ name);
}

// Lambda
var double = (x: int) => { return x * 2; };
var result = double(5);

// Immediately invoked lambda
var r = ((x: int) => { return x * 2; })(5);

// Try / catch / finally
try {
	riskyOperation();
} catch (e) {
	print("Error: " ~ e);
} finally {
	print("Done!");
}

// Try / catch only
try {
	riskyOperation();
} catch (e) {
	print("Error: " ~ e);
}

// Try / finally only
try {
	riskyOperation();
} finally {
	print("Done!");
}

// Throw
throw RuntimeError("oops");

// Using
using math;
using Color, Box from gui;

// Watch
var money: int = 0;
var label: str = "Money: 0";
watch money {
	label = "Money: " ~ money;
}

// Derive
derive doubled: int = money * 2;

// Break / continue
for i in [1..10] {
	if i == 5 {
		break;
	}
	if i == 3 {
		continue;
	}
}

// Class
class Animal {
	var name: str = "";
	var sound: str = "";

	function _init(name: str, sound: str) -> void {
		this.name = name;
		this.sound = sound;
	}

	function speak() -> str {
		return this.name ~ " says " ~ this.sound;
	}
}

class Dog is Animal {
	var tricks: int = 0;

	function _init(name: str) -> void {
		super("Dog", "woof");
		this.name = name;
	}

	function learn_trick() -> void {
		this.tricks += 1;
	}

	watch tricks {
		print("Dog learned a trick! Total: " ~ this.tricks);
	}

	derive is_trained: bool = tricks > 3;
}

// Instantiation and method calls
var dog = Dog("Rex");
dog.learn_trick();
print(dog.speak());
print(dog.is_trained);

// Chained calls
var shouted = "hello" ~> .upper() ~> .trim();

// Nested function calls
print(add(double(2), double(3)));

// Complex expression
var complex = (a + b) * (c - d) / 2 ^ 3;
